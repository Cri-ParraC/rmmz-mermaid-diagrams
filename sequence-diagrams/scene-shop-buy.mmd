sequenceDiagram
    title RPG Maker MZ — Scene_Shop purchase: data in $gameParty

    actor User as Player
    participant Scene as Scene_Shop
    participant BuyWindow as Window_ShopBuy
    participant GameParty as $gameParty
    participant DataManager
    participant dataItems as $dataItems
    participant dataWeapons as $dataWeapons
    participant dataArmors as $dataArmors
    participant GameMap as $gameMap

    User->>Scene: selects an item from the list
    Scene->>Scene: onBuyOk()
    activate Scene
    Scene->>BuyWindow: item()
    activate BuyWindow
    BuyWindow->>BuyWindow: itemAt(index())
    activate BuyWindow
    Note right of BuyWindow: index() = row highlighted by the cursor<br/>_data[index()] = object already resolved from the database<br/>(injected by Scene_Shop via setupGoods)
    BuyWindow-->>BuyWindow: _data[index()]
    deactivate BuyWindow
    BuyWindow-->>Scene: object from $dataItems/$dataWeapons/$dataArmors
    deactivate BuyWindow
    Note right of Scene: this._item = reference to the database object
    deactivate Scene

    User->>Scene: confirms the quantity to buy
    Scene->>Scene: onNumberOk()
    activate Scene
    Note right of Scene: SoundManager.playShop() then, for the "buy" command,<br/>doBuy(_numberWindow.number())
    Scene->>Scene: doBuy(number)

    activate Scene
    Scene->>GameParty: loseGold(number * buyingPrice())
    activate GameParty
    GameParty->>GameParty: gainGold(-amount)
    Note right of GameParty: _gold clamped to 0..maxGold() → 99999999
    deactivate GameParty

    Note over Scene: item is a direct reference to an object of $dataItems/$dataWeapons/$dataArmors<br/>e.g. { id: 1, name: "Potion", price: 50, itypeId: 1, consumable: true, ... }
    Scene->>GameParty: gainItem(item, number)
    activate GameParty

    GameParty->>GameParty: itemContainer(item)
    activate GameParty
    GameParty->>DataManager: isItem(item)
    activate DataManager
    DataManager->>dataItems: includes(item)
    activate dataItems
    dataItems-->>DataManager: true/false
    deactivate dataItems
    DataManager-->>GameParty: true/false
    deactivate DataManager
    alt is a regular item
        GameParty-->>GameParty: returns _items
    else not an item
        GameParty->>DataManager: isWeapon(item)
        activate DataManager
        DataManager->>dataWeapons: includes(item)
        activate dataWeapons
        dataWeapons-->>DataManager: true/false
        deactivate dataWeapons
        DataManager-->>GameParty: true/false
        deactivate DataManager
        alt is a weapon
            GameParty-->>GameParty: returns _weapons
        else is an armor
            GameParty->>DataManager: isArmor(item)
            activate DataManager
            DataManager->>dataArmors: includes(item)
            activate dataArmors
            dataArmors-->>DataManager: true/false
            deactivate dataArmors
            DataManager-->>GameParty: true/false
            deactivate DataManager
            GameParty-->>GameParty: returns _armors
        end
    end
    deactivate GameParty

    GameParty->>GameParty: numItems(item)
    activate GameParty
    Note right of GameParty: calls itemContainer(item) again,<br/>then reads container[item.id] || 0
    GameParty-->>GameParty: lastNumber
    deactivate GameParty

    Note right of GameParty: container[item.id] = (lastNumber + amount).clamp(0, maxItems()) — maxItems() → 99

    GameParty->>GameMap: requestRefresh()
    activate GameMap
    Note right of GameMap: _needsRefresh = true
    deactivate GameMap
    deactivate GameParty
    deactivate Scene
    deactivate Scene
