classDiagram
  note "Overview only: sprite inheritance, spriteset composition and the game objects sprites display. Members of each class are in the per-class files under class-diagrams/rmmz_sprites/"

  class PIXI_Sprite["PIXI.Sprite"]
  class PIXI_TilingSprite["PIXI.TilingSprite"]

  %% Inheritance
  PIXI_Sprite <|-- Sprite
  PIXI_TilingSprite <|-- TilingSprite
  Sprite <|-- Sprite_Clickable
  Sprite_Clickable <|-- Sprite_Button
  Sprite_Clickable <|-- Sprite_Picture
  Sprite_Clickable <|-- Sprite_Battler
  Sprite_Battler <|-- Sprite_Actor
  Sprite_Battler <|-- Sprite_Enemy
  Sprite <|-- Sprite_Character
  Sprite <|-- Sprite_Animation
  Sprite <|-- Sprite_AnimationMV
  TilingSprite <|-- Sprite_Battleback
  Sprite <|-- Sprite_Damage
  Sprite <|-- Sprite_Gauge
  Sprite <|-- Sprite_Name
  Sprite <|-- Sprite_StateIcon
  Sprite <|-- Sprite_StateOverlay
  Sprite <|-- Sprite_Weapon
  Sprite <|-- Sprite_Balloon
  Sprite <|-- Sprite_Timer
  Sprite <|-- Sprite_Destination
  Sprite <|-- Spriteset_Base
  Spriteset_Base <|-- Spriteset_Map
  Spriteset_Base <|-- Spriteset_Battle

  %% Spriteset composition
  Spriteset_Base *-- Sprite_Picture : _pictureContainer
  Spriteset_Base *-- Sprite_Timer : _timerSprite
  Spriteset_Base *-- Sprite_Animation : _animationSprites
  Spriteset_Map *-- Tilemap : _tilemap
  Spriteset_Map *-- Sprite_Character : _characterSprites
  Spriteset_Map *-- Sprite_Balloon : _balloonSprites
  Spriteset_Map *-- Sprite_Destination : _destinationSprite
  Spriteset_Map *-- Weather : _weather
  Spriteset_Battle *-- Sprite_Battleback : _back1Sprite / _back2Sprite
  Spriteset_Battle *-- Sprite_Actor : _actorSprites
  Spriteset_Battle *-- Sprite_Enemy : _enemySprites

  %% Battler sprite parts
  Sprite_Battler *-- Sprite_Damage : _damages
  Sprite_Actor *-- Sprite_Weapon : _weaponSprite
  Sprite_Actor *-- Sprite_StateOverlay : _stateSprite
  Sprite_Enemy *-- Sprite_StateIcon : _stateIconSprite

  %% Game objects being displayed
  Sprite_Character --> Game_CharacterBase : _character
  Sprite_Battler --> Game_Battler : _battler
  Sprite_Gauge --> Game_Battler : _battler
  Sprite_Picture ..> Game_Picture : _pictureId via $gameScreen
