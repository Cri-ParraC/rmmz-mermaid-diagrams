classDiagram
  note "Overview only: Game_* inheritance and ownership. Members of each class are in the per-class files under class-diagrams/rmmz_objects/"

  %% Global state singletons ($gameTemp, $gameSystem, ...)
  class Game_Temp
  class Game_System
  class Game_Timer
  class Game_Message
  class Game_Switches
  class Game_Variables
  class Game_SelfSwitches
  class Game_Screen
  class Game_Picture
  class Game_Item
  class Game_Action
  class Game_ActionResult
  class Game_Actors
  class Game_Map
  class Game_CommonEvent
  class Game_Followers
  class Game_Interpreter

  %% Battlers
  Game_BattlerBase <|-- Game_Battler
  Game_Battler <|-- Game_Actor
  Game_Battler <|-- Game_Enemy

  %% Units
  Game_Unit <|-- Game_Party
  Game_Unit <|-- Game_Troop

  %% Characters
  Game_CharacterBase <|-- Game_Character
  Game_Character <|-- Game_Player
  Game_Character <|-- Game_Follower
  Game_Character <|-- Game_Vehicle
  Game_Character <|-- Game_Event

  %% Battle composition
  Game_Battler *-- Game_ActionResult : _result
  Game_Battler *-- Game_Action : _actions
  Game_Action *-- Game_Item : _item
  Game_Actor *-- Game_Item : _equips
  Game_Actors *-- Game_Actor : _data
  Game_Party o-- Game_Actor : _actors (ids via $gameActors)
  Game_Troop *-- Game_Enemy : _enemies
  Game_Troop *-- Game_Interpreter : _interpreter

  %% Map composition
  Game_Map *-- Game_Event : _events
  Game_Map *-- Game_CommonEvent : _commonEvents
  Game_Map *-- Game_Vehicle : _vehicles
  Game_Map *-- Game_Interpreter : _interpreter
  Game_Event *-- Game_Interpreter : _interpreter
  Game_CommonEvent *-- Game_Interpreter : _interpreter
  Game_Interpreter *-- Game_Interpreter : _childInterpreter
  Game_Player *-- Game_Followers : _followers
  Game_Followers *-- Game_Follower : _data
  Game_Screen *-- Game_Picture : _pictures
