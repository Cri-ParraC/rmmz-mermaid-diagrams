classDiagram
  note "Overview only: static manager objects and how they relate. Members of each class are in the per-class files under class-diagrams/rmmz_managers/"

  class DataManager { <<static>> }
  class ConfigManager { <<static>> }
  class StorageManager { <<static>> }
  class FontManager { <<static>> }
  class ImageManager { <<static>> }
  class EffectManager { <<static>> }
  class AudioManager { <<static>> }
  class SoundManager { <<static>> }
  class TextManager { <<static>> }
  class ColorManager { <<static>> }
  class SceneManager { <<static>> }
  class BattleManager { <<static>> }
  class PluginManager { <<static>> }

  %% Persistence
  DataManager ..> StorageManager : saveGame / loadGame
  ConfigManager ..> StorageManager : save / load config
  DataManager ..> Game_Party : createGameObjects ($game*)
  DataManager ..> Game_Map : createGameObjects ($game*)

  %% Audio and graphics
  SoundManager ..> AudioManager : playStaticSe
  ConfigManager ..> AudioManager : volume settings
  ColorManager ..> ImageManager : windowskin bitmap
  ImageManager ..> Bitmap : load / cache

  %% Scene control
  SceneManager --> Scene_Base : _scene / _nextScene
  SceneManager o-- Scene_Base : _stack
  SceneManager ..> ImageManager : update / clear
  SceneManager ..> EffectManager : update
  SceneManager ..> AudioManager : checkErrors
  SceneManager ..> PluginManager : checkErrors

  %% Battle flow
  BattleManager --> Window_BattleLog : _logWindow
  BattleManager --> Spriteset_Battle : _spriteset
  BattleManager --> Game_Battler : _subject / _actionBattlers
  BattleManager --> Game_Actor : _currentActor
  BattleManager --> Game_Action : _action
  BattleManager ..> SceneManager : push / pop scenes
  BattleManager ..> AudioManager : save / replay map BGM
  BattleManager ..> SoundManager : battle SEs
  BattleManager ..> TextManager : battle messages
